# Шаблон без секретов. Приложение ещё не реализовано; эти ключи — контракт.
ENVIRONMENT=beta
COMPOSE_PROJECT_NAME=marketplace-beta
DB_HOST=postgres
DB_PORT=5432
DB_NAME=mw_beta
DB_WEB_USER=mw_beta_web
DB_WORKER_USER=mw_beta_worker
DB_MIGRATION_USER=mw_beta_migrator
EXTERNAL_READS_ENABLED=false
EXTERNAL_WRITES_ENABLED=false
REAL_MESSAGES_ENABLED=false
SCHEDULES_ENABLED=false
WORKER_CONCURRENCY=1
MAIL_BACKEND=local-file
# Нет DATABASE_URL, WB/API/SMTP credentials или реальных ключей.
# Пути secret files определены в Compose; значения генерируются позднее отдельно.
# BACKEND_IMAGE / POSTGRES_IMAGE: позднее только immutable repo@sha256:<64 hex>.
