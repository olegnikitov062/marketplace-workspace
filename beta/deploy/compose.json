{
  "name": "marketplace-beta",
  "services": {
    "postgres": {
      "restart": "no",
      "mem_limit": "512m",
      "cpus": "0.50",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "postgres@sha256:639ab7ceb90e13123085b741fb31ef493fba25463002f6da665352e7b534b652",
      "environment": {
        "POSTGRES_DB": "mw_beta",
        "POSTGRES_USER": "mw_beta_bootstrap",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_bootstrap_password",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256"
      },
      "secrets": [
        "db_bootstrap_password"
      ],
      "networks": [
        "private"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "../data/postgres",
          "target": "/var/lib/postgresql/data"
        },
        {
          "type": "bind",
          "source": "../backups/database",
          "target": "/backups"
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U mw_beta_bootstrap -d mw_beta"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20
      }
    },
    "postgres-test": {
      "restart": "no",
      "mem_limit": "384m",
      "cpus": "0.25",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "postgres@sha256:639ab7ceb90e13123085b741fb31ef493fba25463002f6da665352e7b534b652",
      "environment": {
        "POSTGRES_DB": "mw_beta_test",
        "POSTGRES_USER": "mw_beta_test_bootstrap",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_test_bootstrap_password",
        "POSTGRES_INITDB_ARGS": "--auth-host=scram-sha-256 --auth-local=scram-sha-256"
      },
      "secrets": [
        "db_test_bootstrap_password"
      ],
      "networks": [
        "test-private"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "../data/postgres-test",
          "target": "/var/lib/postgresql/data"
        },
        {
          "type": "bind",
          "source": "../backups/test",
          "target": "/backups"
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U mw_beta_test_bootstrap -d mw_beta_test"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20
      }
    },
    "web": {
      "restart": "no",
      "mem_limit": "384m",
      "cpus": "0.25",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "${BACKEND_IMAGE:?checked backend image required}",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "user": "10001:10001",
      "tmpfs": [
        "/tmp:size=64m,mode=1777"
      ],
      "networks": [
        "private"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "ENVIRONMENT": "beta",
        "PROCESS_MODE": "web",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "mw_beta",
        "DB_USER": "mw_beta_web",
        "DB_PASSWORD_FILE": "/run/secrets/db_web_password",
        "DJANGO_SECRET_KEY_FILE": "/run/secrets/django_secret_key",
        "EXTERNAL_READS_ENABLED": "false",
        "EXTERNAL_WRITES_ENABLED": "false",
        "REAL_MESSAGES_ENABLED": "false",
        "SCHEDULES_ENABLED": "false"
      },
      "secrets": [
        "db_web_password",
        "django_secret_key"
      ]
    },
    "migrate": {
      "restart": "no",
      "mem_limit": "256m",
      "cpus": "0.25",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "${BACKEND_IMAGE:?checked backend image required}",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "user": "10001:10001",
      "tmpfs": [
        "/tmp:size=64m,mode=1777"
      ],
      "networks": [
        "private"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "ENVIRONMENT": "beta",
        "PROCESS_MODE": "migrate",
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "DB_NAME": "mw_beta",
        "DB_USER": "mw_beta_migrator",
        "DB_PASSWORD_FILE": "/run/secrets/db_migrator_password",
        "DJANGO_SECRET_KEY_FILE": "/run/secrets/django_secret_key",
        "EXTERNAL_READS_ENABLED": "false",
        "EXTERNAL_WRITES_ENABLED": "false",
        "REAL_MESSAGES_ENABLED": "false",
        "SCHEDULES_ENABLED": "false"
      },
      "secrets": [
        "db_migrator_password",
        "django_secret_key"
      ],
      "command": [
        "python",
        "manage.py",
        "migrate",
        "--noinput"
      ],
      "profiles": [
        "maintenance"
      ]
    },
    "test": {
      "restart": "no",
      "mem_limit": "256m",
      "cpus": "0.25",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "${BACKEND_IMAGE:?checked backend image required}",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "user": "10001:10001",
      "tmpfs": [
        "/tmp:size=64m,mode=1777"
      ],
      "networks": [
        "test-private"
      ],
      "depends_on": {
        "postgres-test": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "ENVIRONMENT": "beta",
        "PROCESS_MODE": "test",
        "DB_HOST": "postgres-test",
        "DB_PORT": "5432",
        "DB_NAME": "mw_beta_test",
        "DB_USER": "mw_beta_test_runner",
        "DB_PASSWORD_FILE": "/run/secrets/db_test_runner_password",
        "DJANGO_SECRET_KEY_FILE": "/run/secrets/django_secret_key",
        "EXTERNAL_READS_ENABLED": "false",
        "EXTERNAL_WRITES_ENABLED": "false",
        "REAL_MESSAGES_ENABLED": "false",
        "SCHEDULES_ENABLED": "false"
      },
      "secrets": [
        "db_test_runner_password",
        "django_secret_key"
      ],
      "command": [
        "python",
        "manage.py",
        "test",
        "tests",
        "--noinput",
        "--verbosity",
        "2"
      ],
      "profiles": [
        "maintenance"
      ]
    },
    "bootstrap": {
      "restart": "no",
      "mem_limit": "256m",
      "cpus": "0.25",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "${BACKEND_IMAGE:?checked backend image required}",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "user": "10001:10001",
      "tmpfs": [
        "/tmp:size=64m,mode=1777"
      ],
      "networks": [
        "private"
      ],
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "ENVIRONMENT": "beta",
        "TARGET_TEST": "false"
      },
      "secrets": [
        "db_bootstrap_password",
        "db_migrator_password",
        "db_web_password"
      ],
      "command": [
        "python",
        "tools/bootstrap_roles.py"
      ],
      "profiles": [
        "maintenance"
      ]
    },
    "bootstrap-test": {
      "restart": "no",
      "mem_limit": "256m",
      "cpus": "0.25",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "${BACKEND_IMAGE:?checked backend image required}",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "user": "10001:10001",
      "tmpfs": [
        "/tmp:size=64m,mode=1777"
      ],
      "networks": [
        "test-private"
      ],
      "depends_on": {
        "postgres-test": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "ENVIRONMENT": "beta",
        "TARGET_TEST": "true"
      },
      "secrets": [
        "db_test_bootstrap_password",
        "db_test_runner_password"
      ],
      "command": [
        "python",
        "tools/bootstrap_roles.py"
      ],
      "profiles": [
        "maintenance"
      ]
    }
  },
  "networks": {
    "private": {
      "external": true,
      "name": "marketplace-beta-private"
    },
    "test-private": {
      "name": "marketplace-beta-test-private",
      "internal": true
    }
  },
  "secrets": {
    "db_bootstrap_password": {
      "file": "../config/secrets/db_bootstrap_password"
    },
    "db_migrator_password": {
      "file": "../config/secrets/db_migrator_password"
    },
    "db_web_password": {
      "file": "../config/secrets/db_web_password"
    },
    "db_test_bootstrap_password": {
      "file": "../config/secrets/db_test_bootstrap_password"
    },
    "db_test_runner_password": {
      "file": "../config/secrets/db_test_runner_password"
    },
    "django_secret_key": {
      "file": "../config/secrets/django_secret_key"
    }
  }
}
