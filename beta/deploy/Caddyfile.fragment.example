# НЕ добавлен в общий Caddy. Требуются проверка текущего proxy и отдельное разрешение.
# До публикации beta обязателен закрытый доступ + личный вход; сам блок этого не реализует.
beta-analytics.158-160-30-90.sslip.io {
    @backend path /api /api/* /auth /auth/* /admin /admin/*
    handle @backend {
        reverse_proxy marketplace-beta-web:8000
    }
    handle {
        root * /srv/marketplace/beta/frontend
        try_files {path} /index.html
        file_server
    }
}
# Только read-only mount app/frontend/dist -> /srv/marketplace/beta/frontend.
# Caddy подключается лишь к marketplace-beta-ingress. БД/worker туда не подключать.
