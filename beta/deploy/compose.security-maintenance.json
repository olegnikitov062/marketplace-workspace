{
  "services": {
    "web": {
      "image": "${BACKEND_IMAGE:?existing reviewed rollback image required}",
      "volumes": [
        {
          "type": "bind",
          "source": "${SECURITY_SOURCE:?verified E2-06 read-only worktree backend required}",
          "target": "/workspace",
          "read_only": true
        }
      ],
      "command": [
        "gunicorn",
        "account_security.maintenance:application",
        "--bind",
        "0.0.0.0:8000",
        "--no-control-socket",
        "--workers",
        "1",
        "--threads",
        "2",
        "--timeout",
        "20",
        "--access-logfile",
        "/dev/null",
        "--error-logfile",
        "-"
      ]
    }
  }
}
