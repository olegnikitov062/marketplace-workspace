{
  "name": "marketplace-production",
  "services": {
    "postgres": {
      "profiles": [
        "design-only"
      ],
      "restart": "no",
      "mem_limit": "1g",
      "cpus": "1.0",
      "pids_limit": 128,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "${POSTGRES_IMAGE:?immutable PostgreSQL 17 digest required}",
      "environment": {
        "POSTGRES_DB": "mw_production",
        "POSTGRES_USER": "mw_production_bootstrap",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_bootstrap_password"
      },
      "secrets": [
        "db_bootstrap_password"
      ],
      "networks": [
        "private"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "../data/postgres",
          "target": "/var/lib/postgresql/data"
        }
      ]
    },
    "web": {
      "profiles": [
        "design-only"
      ],
      "restart": "no",
      "mem_limit": "384m",
      "cpus": "0.50",
      "pids_limit": 64,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "${BACKEND_IMAGE:?immutable checked backend digest required}",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "user": "10001:10001",
      "tmpfs": [
        "/tmp:size=64m,mode=1777"
      ],
      "env_file": [
        "../config/runtime.env"
      ],
      "environment": {
        "ENVIRONMENT": "production",
        "DB_HOST": "postgres",
        "DB_NAME": "mw_production",
        "DB_USER": "mw_production_web",
        "DB_PASSWORD_FILE": "/run/secrets/db_web_password",
        "DJANGO_SECRET_KEY_FILE": "/run/secrets/django_secret_key",
        "EXTERNAL_READS_ENABLED": "false",
        "EXTERNAL_WRITES_ENABLED": "false",
        "REAL_MESSAGES_ENABLED": "false",
        "SCHEDULES_ENABLED": "false"
      },
      "secrets": [
        "db_web_password",
        "django_secret_key"
      ],
      "networks": {
        "private": {},
        "ingress": {
          "aliases": [
            "marketplace-production-web"
          ]
        }
      },
      "volumes": [
        {
          "type": "bind",
          "source": "../data/exports",
          "target": "/workspace/exports"
        },
        {
          "type": "bind",
          "source": "../data/mail",
          "target": "/workspace/mail"
        },
        {
          "type": "bind",
          "source": "../logs/web",
          "target": "/workspace/logs"
        }
      ],
      "expose": [
        "8000"
      ]
    },
    "worker": {
      "profiles": [
        "design-only"
      ],
      "restart": "no",
      "mem_limit": "256m",
      "cpus": "0.50",
      "pids_limit": 64,
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "security_opt": [
        "no-new-privileges:true"
      ],
      "image": "${BACKEND_IMAGE:?immutable checked backend digest required}",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "user": "10001:10001",
      "tmpfs": [
        "/tmp:size=64m,mode=1777"
      ],
      "env_file": [
        "../config/runtime.env"
      ],
      "environment": {
        "ENVIRONMENT": "production",
        "DB_HOST": "postgres",
        "DB_NAME": "mw_production",
        "DB_USER": "mw_production_worker",
        "DB_PASSWORD_FILE": "/run/secrets/db_worker_password",
        "DJANGO_SECRET_KEY_FILE": "/run/secrets/django_secret_key",
        "EXTERNAL_READS_ENABLED": "false",
        "EXTERNAL_WRITES_ENABLED": "false",
        "REAL_MESSAGES_ENABLED": "false",
        "SCHEDULES_ENABLED": "false"
      },
      "secrets": [
        "db_worker_password",
        "django_secret_key"
      ],
      "networks": [
        "private"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "../data/exports",
          "target": "/workspace/exports"
        },
        {
          "type": "bind",
          "source": "../data/mail",
          "target": "/workspace/mail"
        },
        {
          "type": "bind",
          "source": "../logs/worker",
          "target": "/workspace/logs"
        }
      ]
    }
  },
  "networks": {
    "private": {
      "name": "marketplace-production-private",
      "internal": true
    },
    "ingress": {
      "name": "marketplace-production-ingress",
      "external": true
    }
  },
  "secrets": {
    "db_bootstrap_password": {
      "file": "../config/secrets/db_bootstrap_password"
    },
    "db_web_password": {
      "file": "../config/secrets/db_web_password"
    },
    "db_worker_password": {
      "file": "../config/secrets/db_worker_password"
    },
    "django_secret_key": {
      "file": "../config/secrets/django_secret_key"
    }
  }
}
